# Development Environment Variables

# Database Configuration (Required for database operations)
# Format: mysql://user:password@host:port/database
# Example: mysql://root:password@localhost:3306/reqtofrd
DATABASE_URL=mysql://user:password@localhost:3306/reqtofrd

# OpenRouter LLM API (Required for FRD generation and clarification)
# Get your API key from: https://openrouter.ai/keys
# Optional: Users can provide this at runtime via UI
OPENROUTER_API_KEY=sk-or-v1-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Server Configuration
# Port the Express server listens on (defaults to 3000)
PORT=3000

# Environment Mode
# Use "development" for local development with Vite HMR
# Use "production" for optimized production build
NODE_ENV=development

# Optional: AWS S3 Configuration (if using S3 file storage)
# AWS_ACCESS_KEY_ID=your-access-key
# AWS_SECRET_ACCESS_KEY=your-secret-key
# AWS_S3_BUCKET=your-bucket-name
# AWS_S3_REGION=us-east-1

# Optional: Google Maps API (if using map components)
# GOOGLE_MAPS_API_KEY=your-google-maps-api-key
